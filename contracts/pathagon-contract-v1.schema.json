{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathagon.invalid/contracts/pathagon-contract-v1.schema.json",
  "title": "Pathagon interchange contract v1",
  "description": "The versioned interchange shape shared by the TypeScript, Rust, and Python engines.",
  "type": "object",
  "$ref": "#/$defs/replayRecord",
  "$defs": {
    "player": { "type": "string", "enum": ["light", "dark"] },
    "terminationReason": {
      "type": "string",
      "enum": ["path", "threefold-repetition", "max-plies", "no-legal-action"]
    },
    "gameConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulesVersion", "boardSize", "reservePerPlayer", "maxPlies", "repetitionLimit"],
      "properties": {
        "rulesVersion": { "type": "string", "const": "pathagon-rules-v1" },
        "boardSize": { "type": "integer", "minimum": 3, "maximum": 8 },
        "reservePerPlayer": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxPlies": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "repetitionLimit": { "type": "integer", "const": 3 }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to"],
          "properties": {
            "kind": { "const": "place" },
            "to": { "type": "integer", "minimum": 0, "maximum": 63 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "relocate" },
            "from": { "type": "integer", "minimum": 0, "maximum": 63 },
            "to": { "type": "integer", "minimum": 0, "maximum": 63 }
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "config", "board", "reserve", "turn", "forbidden", "lastRelocatedTo", "winner", "ply"],
      "properties": {
        "contractVersion": { "const": 1 },
        "config": { "$ref": "#/$defs/gameConfig" },
        "board": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": ["string", "null"], "enum": ["light", "dark", null] }
        },
        "reserve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "type": "integer", "minimum": 0, "maximum": 255 },
            "dark": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "turn": { "$ref": "#/$defs/player" },
        "forbidden": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 63 } },
        "lastRelocatedTo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "type": ["integer", "null"], "minimum": 0, "maximum": 63 },
            "dark": { "type": ["integer", "null"], "minimum": 0, "maximum": 63 }
          }
        },
        "winner": { "oneOf": [{ "$ref": "#/$defs/player" }, { "type": "null" }] },
        "ply": { "type": "integer", "minimum": 0, "maximum": 4096 }
      }
    },
    "engineMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime", "version", "rulesVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "runtime": { "type": "string", "enum": ["typescript", "rust", "python"] },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$" },
        "rulesVersion": { "type": "string", "const": "pathagon-rules-v1" }
      }
    },
    "evaluatorWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "material", "capture", "structure", "threat", "edge"],
      "properties": {
        "path": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "material": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "capture": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "structure": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "threat": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "edge": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "agentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "runtime", "rulesVersion", "evaluatorWeights", "depth", "nodeBudget", "beam", "modelHash"],
      "properties": {
        "manifestVersion": { "const": 1 },
        "runtime": { "type": "string", "enum": ["typescript", "rust", "python"] },
        "rulesVersion": { "type": "string", "const": "pathagon-rules-v1" },
        "evaluatorWeights": { "$ref": "#/$defs/evaluatorWeights" },
        "depth": { "type": "integer", "minimum": 0 },
        "nodeBudget": { "type": "integer", "minimum": 0 },
        "beam": { "type": "integer", "minimum": 0 },
        "modelHash": { "type": ["string", "null"], "pattern": "^sha256:[A-Fa-f0-9]{64}$" }
      }
    },
    "agentSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "kind", "engineId", "manifest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$" },
        "kind": { "type": "string", "enum": ["random", "heuristic", "search", "learned", "puct"] },
        "engineId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "manifest": { "$ref": "#/$defs/agentManifest" },
        "parameters": { "type": "object" }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ply", "player", "action", "captured", "nodes", "completedDepth", "tableHits"],
      "properties": {
        "ply": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "player": { "$ref": "#/$defs/player" },
        "action": { "$ref": "#/$defs/action" },
        "captured": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 63 } },
        "nodes": { "type": "integer", "minimum": 0 },
        "completedDepth": { "type": "integer", "minimum": 0, "maximum": 255 },
        "tableHits": { "type": "integer", "minimum": 0 },
        "score": { "type": "integer" },
        "bookHit": { "type": "boolean" }
      }
    },
    "replayRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "seed", "config", "engine", "agents", "agentSpecifications", "winner", "result", "reason", "plies", "moves"],
      "properties": {
        "contractVersion": { "const": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "config": { "$ref": "#/$defs/gameConfig" },
        "engine": { "$ref": "#/$defs/engineMetadata" },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
            "dark": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
          }
        },
        "agentSpecifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": { "$ref": "#/$defs/agentSpecification" },
            "dark": { "$ref": "#/$defs/agentSpecification" }
          }
        },
        "winner": { "oneOf": [{ "$ref": "#/$defs/player" }, { "type": "null" }] },
        "result": { "type": "string", "enum": ["win", "draw"] },
        "reason": { "$ref": "#/$defs/terminationReason" },
        "plies": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "moves": { "type": "array", "items": { "$ref": "#/$defs/move" }, "maxItems": 4096 }
      }
    }
  }
}
