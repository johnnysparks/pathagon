{
  "name": "pathagon",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @pathagon/web",
    "build": "npm run build --workspace @pathagon/web",
    "test": "npm run test:data && npm run test:web && npm run test:rust && npm run test:python",
    "test:data": "bash scripts/check-data-policy.sh",
    "test:web": "npm test --workspace @pathagon/web",
    "test:rust": "cargo test --manifest-path pathagon/engine-rs/Cargo.toml --all-targets --release -j1",
    "test:python": "bash scripts/test-python.sh",
    "test:parity": "bash scripts/test-parity.sh",
    "lint": "npm run lint --workspace @pathagon/web",
    "build:engine": "bash scripts/build-rust-wasm.sh",
    "selfplay:archive": "node --experimental-strip-types scripts/archive-selfplay.ts",
    "rust:selfplay": "cargo run --release --manifest-path pathagon/engine-rs/Cargo.toml --bin pathagon-selfplay --",
    "rust:learn": "cargo run --release --manifest-path pathagon/engine-rs/Cargo.toml --bin pathagon-learn --",
    "rust:train": "cargo run --release --manifest-path pathagon/engine-rs/Cargo.toml --bin pathagon-train --"
  }
}
