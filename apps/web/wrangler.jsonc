{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pathagon-game",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pathagon-web",
      "database_id": "6847a931-70df-407b-b8fc-5d02e6f8f293",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
